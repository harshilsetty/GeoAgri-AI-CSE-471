# GeoAgri-AI Environment Configuration Example

# Backend URL for Next.js UI integration (Mandatory for frontend-backend communication)
PREDICT_BACKEND_URL=http://127.0.0.1:8000

# Path to Python executable (Optional - auto-detected from active virtual environment)
# PYTHON_EXECUTABLE=./.venv/Scripts/python.exe

# Groq API Key for Optional LLM Agronomic Explanations (Optional)
# If not provided, GeoAgri-AI automatically falls back to deterministic TreeSHAP + Agronomic Knowledge Rules.
# GROQ_API_KEY=your_groq_api_key_here

